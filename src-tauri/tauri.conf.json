{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataCanvas",
  "version": "0.1.0",
  "identifier": "com.datacanvas.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DataCanvas",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "publisher": "DataCanvas",
    "copyright": "Copyright © 2026 DataCanvas",
    "category": "Business",
    "shortDescription": "Offline analytics dashboards",
    "longDescription": "DataCanvas Desktop builds dashboards from CSV and Excel files entirely on your computer. No data leaves the machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["datacanvas"],
        "name": "DataCanvas Project",
        "description": "DataCanvas Project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.datacanvas.project+zip",
        "exportedType": {
          "identifier": "com.datacanvas.desktop.project",
          "conformsTo": ["public.data", "public.zip-archive"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "e2e817b4-554a-51e5-9eb9-7803c7217e8e",
        "language": "en-US"
      }
    }
  }
}
