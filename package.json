    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "d3-interpolate": "^3.0.2",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
